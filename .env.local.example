# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub. The .gitignore already excludes it.

# Your KoboToolbox API token (regenerate it after the leak!)
KOBO_API_TOKEN=paste_your_new_token_here

# Kobo instance base URL. For kf.kobotoolbox.org accounts use the default.
# If your account is on the humanitarian instance, use:
#   https://kobo.humanitarianresponse.info
KOBO_BASE_URL=https://kf.kobotoolbox.org

# Asset UID of your water meter form. See README "Finding your Asset UID".
# Looks like: aXXXXXXXXXXXXXXXXXXXXX
KOBO_ASSET_UID=paste_your_asset_uid_here

# A random secret for the Kobo -> Vercel webhook. Pick any long random string.
# Generate one at https://generate-secret.vercel.app/32
WEBHOOK_SECRET=change_me_to_a_long_random_string
